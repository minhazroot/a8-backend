PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/studiospace?retryWrites=true&w=majority
MONGODB_DB=studiospace
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SEED_HOST_EMAIL=host@studiospace.com
SEED_HOST_PASSWORD=CHANGE_TO_A_STRONG_DEMO_PASSWORD

# Optional: Enable server-side image upload (ImgBB)
IMGBB_API_KEY=

# Assignment authentication (opt-in; configure secrets and Google OAuth)
AUTH_PROVIDER=better-auth
API_ORIGIN=http://localhost:5000
BETTER_AUTH_SECRET=CHANGE_TO_AN_INDEPENDENT_32_CHARACTER_RANDOM_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud OAuth redirect URI: http://localhost:5000/api/better-auth/callback/google
